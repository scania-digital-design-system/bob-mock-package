{
  "name": "@umain-mock/bob-mock-react",
  "version": "0.1.0",
  "description": "Tegel components hand-written in brand-orchestration-backbone cell shape. For testing only.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scania.css": "./dist/scania.css"
  },
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "scripts": {
    "dev": "vite serve demo --config vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "types": "vitest run tests/prop-types.test.ts --update",
    "gate": "cd bob && go run . gate -root ..",
    "tokens": "cd bob && go run . tokens -root ..",
    "cell": "cd bob && go run . cell -root ..",
    "test:bob": "cd bob && go vet ./... && go test ./..."
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@scania/tegel": "1.66.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
